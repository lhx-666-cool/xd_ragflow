# 复制为 .env.sidecar，权限设为 600。不要把真实密钥提交到版本库。
TEXTBOOK_KG_API_TOKEN=replace-with-a-random-token
TEXTBOOK_KG_REQUIRE_AUTH=true
TEXTBOOK_KG_REQUIRE_JOB_MODELS=true
TEXTBOOK_KG_WORKER_CONCURRENCY=1
TEXTBOOK_KG_MAX_UPLOAD_BYTES=2147483648
TEXTBOOK_KG_UID=1000
TEXTBOOK_KG_GID=1000

# 必须指向与宿主机网络可达的 MinerU FastAPI 根地址，不含 /file_parse。
MINERU_API_URL=http://127.0.0.1:8886

# 生产任务从 RAGFlow 当前知识库/租户模型配置取值，不在 Sidecar 配置供应商 API Key。
